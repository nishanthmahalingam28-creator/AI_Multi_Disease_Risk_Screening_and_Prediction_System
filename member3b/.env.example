# Member 3B Backend Environment Configuration Template
# Copy this file to .env for local configuration overrides.
# NOTE: Never store real secrets, tokens, or private credentials in this file.

# Local Development Defaults:
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
FLASK_ENV=production

# Production / Container Deployment Notes:
# Set HOST=0.0.0.0 for container / cloud platform binding.
# PORT is typically supplied automatically by the cloud platform (e.g. Render $PORT).

